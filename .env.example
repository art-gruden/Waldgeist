# ---- Enchanted Companions configuration. Copy to .env and keep it secret (chmod 600). ----

# Bot token from @BotFather
BOT_TOKEN=

# Telegram ID of the study group (a negative number like -1001234567890).
# Add the bot to the group as an admin, send /chatid in the group (admins only), paste the number here.
GROUP_CHAT_ID=

# Numeric Telegram IDs of game admins, comma-separated: @artgruden, @omniyaskala
ADMIN_TG_IDS=835852842,2116564097

# PostgreSQL. install.sh generates the password. Use letters and digits only (it is part of a URL).
POSTGRES_PASSWORD=
POSTGRES_USER=ec
POSTGRES_DB=enchanted

# Daily database backup time (Kyiv) and retention
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14

LOG_LEVEL=INFO

# Local development only (in Docker the bot gets DATABASE_URL from docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://ec:devpassword@localhost:5432/enchanted
