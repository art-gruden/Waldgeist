# Обов'язково: токен від @BotFather
BOT_TOKEN=

# Необов'язково: ID адміністраторів через кому (свій ID: команда /id у боті).
# Якщо порожньо — адміном стає перший, хто напише боту /start.
ADMIN_IDS=

# Початкові значення для нових користувачів (далі все змінюється в меню бота):
# DEFAULT_TITLE=ЕНЕРГОЗАВАНТАЖЕННЯ
# DEFAULT_SIZE=1280x782
# DEFAULT_TEMPLATE=pink_glow

# Ліміти
# MAX_WORDS=40
# MAX_CHARS=400
# MAX_UPLOAD_MB=20
# RENDER_CONCURRENCY=2
# LOG_LEVEL=INFO

# Власний сервер Bot API (зазвичай не потрібно)
# TELEGRAM_API_URL=http://telegram-bot-api:8081/bot
# TELEGRAM_FILE_URL=http://telegram-bot-api:8081/file/bot
